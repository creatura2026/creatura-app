{
  "name": "@creatura/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Thème, composants et types partagés entre la PWA joueur et le dashboard admin",
  "exports": {
    "./theme.css": "./src/theme.css",
    "./ui/*": "./src/ui/*",
    "./assets/*": "./src/assets/*",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../../creatura-api.openapi.yaml -o src/api/schema.d.ts",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jersey-20": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.0",
    "vee-validate": "^4.15.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vee-validate": "^4.15.0",
    "zod": "^4.6.6"
  }
}
