# Copier en .env puis adapter. Lu par uvicorn et par docker compose (compose.yaml) :
# sans .env, docker compose vise la base locale de db/.

# Même format que db/README.md. La base locale se lance depuis db/ (docker compose up -d).
# En production (RDS) : ajouter ?sslmode=require
DATABASE_URL=postgres://creatura:creatura@127.0.0.1:5432/creatura

# RDS avec authentification IAM (le mot de passe est un jeton signé, pas besoin de mot de passe).
# Poste local : par le tunnel SSM (scripts/tunnel-rds.sh), la base répond sur le port 15432 ;
# host.docker.internal pour l'API dans Docker, localhost pour uv run uvicorn (voir README).
# DATABASE_URL=postgres://creatura_back@host.docker.internal:15432/creatura?sslmode=require
# DB_IAM_AUTH=true
# Derrière le tunnel : vraie adresse de la RDS, pour signer le jeton. Vide sur EKS (accès direct).
# DB_IAM_HOST=<endpoint-rds>
# DB_IAM_PORT=5432
# AWS_REGION=eu-north-1
# Poste local : clés d'un utilisateur IAM. Sur EKS : ne rien mettre, le rôle IAM du pod suffit.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Clé de signature des JWT : à remplacer (ex. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=a-remplacer-par-une-longue-chaine-aleatoire-en-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Jour du booster (minuit à minuit). Le nombre de cartes est un réglage en base (dashboard admin).
TIMEZONE=Europe/Paris

# CDN des illustrations : la clé stockée en base (sprites/moss_puff.png) y est concaténée
IMAGE_BASE_URL=https://d2qfl3ji3yaa9i.cloudfront.net

# Origines autorisées pour le front (séparées par des virgules)
# Inutile avec le proxy Vite ou l'Ingress (même origine) ; utile si le front est sur un autre domaine.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Compte administrateur créé au démarrage s'il n'existe pas.
# Inutile en local avec les données de démo (admin/admin existe déjà).
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=a-remplacer
# ADMIN_PSEUDO=Admin
