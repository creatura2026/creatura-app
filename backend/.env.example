# Copier en .env puis adapter (utile pour lancer uvicorn hors Docker).

# Même format que db/README.md. La base locale se lance depuis db/ (docker compose up -d).
# En production (RDS) : ajouter ?sslmode=require
DATABASE_URL=postgres://creatura:creatura@localhost:5432/creatura

# Clé de signature des JWT : à remplacer (ex. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=a-remplacer-par-une-longue-chaine-aleatoire-en-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Règles du booster (à valider au point client)
BOOSTER_SIZE=5
TIMEZONE=Europe/Paris

# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Compte administrateur créé au démarrage s'il n'existe pas.
# Inutile en local avec les données de démo (admin/admin existe déjà).
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=a-remplacer
# ADMIN_PSEUDO=Admin
