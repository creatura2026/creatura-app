# CREATURA - Variables de la base locale (copier en .env, jamais commiter .env)

# Utilisateur, mot de passe et base créés au premier démarrage
POSTGRES_USER=creatura
POSTGRES_PASSWORD=creatura
POSTGRES_DB=creatura

# Port exposé sur ton PC (change-le si 5432 est déjà pris)
DB_PORT=5432

# true = ajoute les comptes de démo (admin/admin, joueur1/joueur1, joueur2/joueur2)
# LOCAL UNIQUEMENT
CREATURA_DEMO=true

# Pour le back (à recopier dans son propre .env)
# DATABASE_URL=postgres://creatura:creatura@localhost:5432/creatura
