{
  "name": "creatura-app",
  "private": true,
  "scripts": {
    "dev:player": "pnpm --filter player dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:player:mock": "pnpm --filter player dev:mock",
    "dev:admin:mock": "pnpm --filter admin dev:mock",
    "build": "pnpm -r run build",
    "desktop": "pnpm --filter desktop dist",
    "desktop:demo": "pnpm --filter desktop dist:demo",
    "mobile": "pnpm --filter mobile dist",
    "mobile:demo": "pnpm --filter mobile dist:demo",
    "test:unit": "pnpm -r run test:unit --run",
    "test:e2e": "pnpm --filter e2e test",
    "test:ui": "pnpm --filter e2e test:ui",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format"
  }
}
